# Copy to project root: cp .env.example .env

# Backend only — never expose as VITE_*
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_SUGGESTION_MODEL=gemini-2.5-flash
# Optional override for live transcription model
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash

FRONTEND_URL=http://127.0.0.1:5173
PORT=5000

# Required in production (no default secret)
SECRET_KEY=change-me-to-a-long-random-string

# Frontend (safe to expose — not a secret)
VITE_BACKEND_URL=http://127.0.0.1:5000

# Optional
# HINTER_SUGGESTION_DEBOUNCE=8
# DATABASE_URL=postgresql://...
