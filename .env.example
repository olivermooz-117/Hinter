# Copy to project root:
#   cp .env.example .env

# --- Required for LLM suggestions only (not for transcription) ---
# https://platform.openai.com/api-keys
# Needs billing credits: platform.openai.com → Settings → Billing
OPENAI_API_KEY=sk-your-key-here

# --- Local Whisper (offline STT — no API credits) ---
WHISPER_MODEL_SIZE=base.en
# Options: tiny.en (fastest), base.en (default), small.en (better quality)
WHISPER_LANGUAGE=en
WHISPER_VAD=true
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# --- Optional ---
# HINTER_LLM_MODEL=gpt-4o-mini
# HINTER_SUGGESTION_DEBOUNCE=8
# HINTER_PORT=5000