# Copy to project root:
#   cp .env.example .env

# Backend: keep GEMINI_API_KEY server-side. Never rename it to VITE_GEMINI_API_KEY.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_SUGGESTION_MODEL=gemini-2.5-flash
FRONTEND_URL=http://127.0.0.1:5173
PORT=5000

# Frontend/Electron: this URL is safe to expose because it is not a secret.
VITE_BACKEND_URL=http://127.0.0.1:5000

# Optional local tuning
# HINTER_SUGGESTION_DEBOUNCE=8
# HINTER_PORT=5000