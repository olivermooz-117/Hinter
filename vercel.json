{
  "buildCommand": "cd apps/web && npm install && npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/socket.io/(.*)", "destination": "/socket.io/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
